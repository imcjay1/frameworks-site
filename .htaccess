# Frameworks Studios — Apache configuration for cPanel hosting.
#
# This is the Apache counterpart to vercel.json, which is kept so the project
# can still be deployed to Vercel. Anything changed in one belongs in the other:
#   cleanUrls      -> the .html rewrite/redirect pair below
#   trailingSlash  -> the trailing-slash redirect
#   redirects      -> /sectors -> /works
#   headers        -> the Cache-Control block
#
# /api/contact is served by api/contact.php here; on Vercel it is api/contact.js.

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------- canonical host --
# One address for the site: https, with www. Everything else redirects once.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.frameworksstudios.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^www\.frameworksstudios\.com$ [NC]
RewriteRule ^ https://www.frameworksstudios.com%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------- the form API --
# Must come before the clean-URL rules, which would otherwise look for
# api/contact.html and 404.
RewriteRule ^api/contact/?$ api/contact.php [L]

# ------------------------------------------------------- the old /sectors URL --
RewriteRule ^sectors/?$ /works [R=301,L]

# ------------------------------------------------------------- clean URLs ----
# 1. Requests that arrive with .html or a trailing slash are redirected to the
#    canonical extensionless form, so a page is only ever served at one address.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# 2. Having redirected, serve the .html file behind the clean URL.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ------------------------------------------------------------------ caching --
<IfModule mod_headers.c>
  # Fonts, images and video are versioned by filename (or by a ?v= query on the
  # favicons) and never change in place.
  <FilesMatch "\.(woff2?|ttf|otf|eot|mp4|webm|jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Stylesheets and scripts are not fingerprinted, so they must revalidate or an
  # edit would take a year to reach anyone.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Pages always revalidate; they are small and they change.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# -------------------------------------------------------------- compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------- correct types --
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# ------------------------------------------------- things that are not the site --
# The repo carries working documents and build scripts. They are deployed with
# everything else but must never be served.
<FilesMatch "\.(py|pyc|md|json|yml|yaml|sh|log)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/(docs|tools|\.git|\.claude)(/|$)
