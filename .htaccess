# Frameworks Studios — Apache configuration for cPanel hosting.
#
# This is the Apache counterpart to vercel.json, which is kept so the project
# can still be deployed to Vercel. Anything changed in one belongs in the other.
#
# READ THIS BEFORE ADDING A GLOBAL RULE.
# public_html is not only this site. Roughly sixty client virtual tours live
# alongside it as top-level directories — /MahdSportsAcademy/, /BentleyBacalar/,
# /LuxuryVilla/ and so on — and the Works page links straight to them. They are
# the studio's delivered work, some of it embedded in clients' own pages.
# So every rule below is scoped to the six site pages or to /assets, and the
# things that would quietly break a tour are deliberately absent:
#
#   * DirectoryIndex keeps index.htm, which is what the tours are built around.
#   * No blanket deny on .json — the tours load manifest.json and friends.
#   * No X-Frame-Options — clients embed these tours in their own sites.
#   * No long cache lives outside /assets, so a retouched tour appears at once.

Options -MultiViews

# index.htm first-class: the tours are built around it, this site uses .html.
DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# ------------------------------------------------------------ canonical host --
# One address for everything, tours included: https, with www.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.frameworksstudios.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^www\.frameworksstudios\.com$ [NC]
RewriteRule ^ https://www.frameworksstudios.com%{REQUEST_URI} [R=301,L]

# -------------------------------------------------------------- the form API --
RewriteRule ^api/contact/?$ api/contact.php [L]

# -------------------------------------------------------- the old /sectors URL --
RewriteRule ^sectors/?$ /works [R=301,L]

# ------------------------------------------------- clean URLs, six pages only --
# The THE_REQUEST guard matches only what the browser actually asked for, so
# the internal rewrite at the bottom cannot feed these rules and loop.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(studio|craft|works|digital-services|contact)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteRule ^(studio|craft|works|digital-services|contact)/$ /$1 [R=301,L]

RewriteRule ^(studio|craft|works|digital-services|contact)$ /$1.html [L]
</IfModule>

# ------------------------------------------------------------------- headers --
# Scoped to this site's pages by filename. The tours serve index.htm, so they
# never match. Cache lives for /assets are set in assets/.htaccess.
<IfModule mod_headers.c>
  <FilesMatch "^(index|studio|craft|works|digital-services|contact)\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------- compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------- correct types --
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# ---------------------------------------------- inherited from the old config --
# Kept verbatim from the WordPress-era .htaccess: an abusive address the account
# owner blocked, and cPanel's own PHP handler, which api/contact.php needs.
<Files 403.shtml>
order allow,deny
allow from all
</Files>

deny from 52.169.70.224

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
