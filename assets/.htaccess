# Cache lives for this site's own assets only. Scoping them to this directory
# keeps them away from the client tours in the sibling directories, which are
# retouched in place and must not be pinned in anyone's browser for a year.
<IfModule mod_headers.c>
  # Fonts, images and video here are versioned by filename, or by a ?v= query
  # on the favicons, and never change in place.
  <FilesMatch "\.(woff2?|ttf|otf|eot|mp4|webm|jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # site.css and site.js are not fingerprinted, so they must revalidate or an
  # edit would take a year to reach anyone.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
